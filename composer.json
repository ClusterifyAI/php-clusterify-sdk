{
    "name": "clusterify/chatbot-sdk",
    "description": "Official PHP SDK for Clusterify.AI Chatbot API",
    "homepage": "https://clusterify.ai",
    "keywords": [
        "clusterify",
        "clusterify-ai",
        "chatbot",
        "ai",
        "knowledge-base",
        "sdk",
        "api-client"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Clusterify.AI",
            "email": "support@clusterify.ai",
            "homepage": "https://clusterify.ai"
        }
    ],
    "support": {
        "docs": "https://dashboard.clusterify.ai",
        "email": "support@clusterify.ai"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0 || ^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Clusterify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clusterify\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
